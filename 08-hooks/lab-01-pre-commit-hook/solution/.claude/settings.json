{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-todo-commit.sh"
          }
        ]
      }
    ]
  }
}
